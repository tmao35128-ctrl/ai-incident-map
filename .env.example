# このファイルをコピーして .env という名前にし、値を貼ってください（.env はGitに上げない）

# Claude API（トレンドボットと同じ鍵でOK）
ANTHROPIC_API_KEY=

# Notionの連携トークン（トレンドボットと同じ鍵でOK。「MY WORK SPACE」に接続済みのもの）
NOTION_TOKEN=

# LINE（Novaのボットの鍵。未設定なら通知だけスキップされる）
LINE_CHANNEL_ACCESS_TOKEN=
# 自分だけに送るなら自分のユーザーID（空なら友だち全員に送る）
LINE_USER_ID=

# 判定に使うモデルを変えたいときだけ（初期値 claude-opus-5-5）
# CLAUDE_MODEL=claude-haiku-5-5
